import { describe, it, expect, beforeEach, vi } from 'vitest'
import { supabase } from '@/lib/supabase'
import {
  getCurrentUserId,
  requireUserId,
  isAuthenticated,
  getUserRole,
  getUserProfile,
  isAdmin,
  requireAdmin,
  isAccountActive,
  requireActiveAccount,
  hasActiveSubscription
} from '@/lib/auth'

describe('Authentication Utilities', () => {
  beforeEach(() => {
    vi.clearAllMocks()
  })

  describe('getCurrentUserId', () => {
    it('should return user ID when authenticated', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const userId = await getCurrentUserId()
      expect(userId).toBe('test-user-123')
    })

    it('should return null when not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      const userId = await getCurrentUserId()
      expect(userId).toBeNull()
    })

    it('should return null on error', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: new Error('Session error') as any
      })

      const userId = await getCurrentUserId()
      expect(userId).toBeNull()
    })
  })

  describe('requireUserId', () => {
    it('should return user ID when authenticated', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const userId = await requireUserId()
      expect(userId).toBe('test-user-123')
    })

    it('should throw error when not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      await expect(requireUserId()).rejects.toThrow('User must be authenticated')
    })
  })

  describe('isAuthenticated', () => {
    it('should return true when user is authenticated', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const authenticated = await isAuthenticated()
      expect(authenticated).toBe(true)
    })

    it('should return false when user is not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      const authenticated = await isAuthenticated()
      expect(authenticated).toBe(false)
    })
  })

  describe('getUserRole', () => {
    it('should return user role when authenticated', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { role: 'Admin' },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const role = await getUserRole()
      expect(role).toBe('Admin')
    })

    it('should return "User" as default when not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      const role = await getUserRole()
      expect(role).toBe('User')
    })

    it('should return "User" on database error', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: null,
              error: new Error('Database error')
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const role = await getUserRole()
      expect(role).toBe('User')
    })
  })

  describe('getUserProfile', () => {
    it('should return user profile when authenticated', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockProfile = {
        id: 'test-user-123',
        role: 'User',
        created_at: '2025-01-01T00:00:00Z',
        updated_at: '2025-01-01T00:00:00Z'
      }

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: mockProfile,
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const profile = await getUserProfile()
      expect(profile).toEqual(mockProfile)
    })

    it('should return null when not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      const profile = await getUserProfile()
      expect(profile).toBeNull()
    })
  })

  describe('isAdmin', () => {
    it('should return true for admin users', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { role: 'Admin' },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const admin = await isAdmin()
      expect(admin).toBe(true)
    })

    it('should return false for non-admin users', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { role: 'User' },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const admin = await isAdmin()
      expect(admin).toBe(false)
    })
  })

  describe('requireAdmin', () => {
    it('should not throw for admin users', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { role: 'Admin' },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      await expect(requireAdmin()).resolves.not.toThrow()
    })

    it('should throw for non-admin users', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { role: 'User' },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      await expect(requireAdmin()).rejects.toThrow('Admin access required')
    })
  })

  describe('isAccountActive', () => {
    it('should return true for active accounts', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { is_active: true },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const active = await isAccountActive()
      expect(active).toBe(true)
    })

    it('should return false for disabled accounts', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { is_active: false },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const active = await isAccountActive()
      expect(active).toBe(false)
    })

    it('should return false when not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      const active = await isAccountActive()
      expect(active).toBe(false)
    })

    it('should default to true when is_active is null', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { is_active: null },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const active = await isAccountActive()
      expect(active).toBe(true)
    })
  })

  describe('requireActiveAccount', () => {
    it('should not throw for active accounts', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { is_active: true },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      await expect(requireActiveAccount()).resolves.not.toThrow()
    })

    it('should throw and sign out for disabled accounts', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { is_active: false },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const signOutMock = vi.fn()
      vi.mocked(supabase.auth.signOut).mockImplementation(signOutMock as any)

      await expect(requireActiveAccount()).rejects.toThrow('Your account has been disabled')
      expect(signOutMock).toHaveBeenCalled()
    })
  })

  describe('hasActiveSubscription', () => {
    it('should return true for active subscriptions', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      // Future date
      const futureDate = new Date()
      futureDate.setDate(futureDate.getDate() + 30)

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { subscription_expires_at: futureDate.toISOString() },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const hasSubscription = await hasActiveSubscription()
      expect(hasSubscription).toBe(true)
    })

    it('should return false for expired subscriptions', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      // Past date
      const pastDate = new Date()
      pastDate.setDate(pastDate.getDate() - 30)

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { subscription_expires_at: pastDate.toISOString() },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const hasSubscription = await hasActiveSubscription()
      expect(hasSubscription).toBe(false)
    })

    it('should return false when subscription_expires_at is null', async () => {
      const mockSession = {
        user: { id: 'test-user-123', email: 'test@example.com' }
      }

      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: mockSession as any },
        error: null
      })

      const mockFrom = vi.fn(() => ({
        select: vi.fn(() => ({
          eq: vi.fn(() => ({
            single: vi.fn(() => Promise.resolve({
              data: { subscription_expires_at: null },
              error: null
            }))
          }))
        }))
      }))
      vi.mocked(supabase.from).mockImplementation(mockFrom as any)

      const hasSubscription = await hasActiveSubscription()
      expect(hasSubscription).toBe(false)
    })

    it('should return false when not authenticated', async () => {
      vi.mocked(supabase.auth.getSession).mockResolvedValue({
        data: { session: null },
        error: null
      })

      const hasSubscription = await hasActiveSubscription()
      expect(hasSubscription).toBe(false)
    })
  })
})
