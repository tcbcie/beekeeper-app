# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.backup

# sql exports, dumps, keys and backups (never commit data or credentials)
/sql/
*export*.sql
*backup*.sql
*.dump
*.key
*.p12
*.pfx
backups/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mcp servers
.mcp.json
# Supabase CLI local state (project ref, pooler host)
supabase/.temp/

# Claude Code local settings
.claude/settings.local.json

# Claude temp files
tmpclaude-*
_ul

# Codex local settings
.codex/config.toml

# Codex scratch/temp files
.codex-temp/

# Personal contact data, kept out of the public repository (SUP-07)
external_references/Emails_Beekeeping_Associations.csv
