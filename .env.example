# Names only. Never put real values in this file.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Stripe (test keys locally, live keys in production)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# App address, used for the Stripe return links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (Mel chat, voice notes, knowledge base)
OPENAI_API_KEY=sk-your-openai-key-here

# Mapbox (public token; restrict it to your web addresses in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token-here

# Google Geocoding (Eircode lookup, server only)
GOOGLE_MAPS_API_KEY=your-google-geocoding-key-here

# Resend (email)
RESEND_API_KEY=re_your-resend-key-here

# Error monitoring (Sentry, EU region). The DSN is public; the auth token is a build-only secret.
NEXT_PUBLIC_SENTRY_DSN=https://key@o000000.ingest.de.sentry.io/0000000
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=sntrys_your-build-token-here

# Web Push (VAPID key pair). The public key is needed by the app (Vercel); the private key only
# by the reminder sender (Supabase edge-function secret), never in Vercel or the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_KEYS={"publicKey":{...JWK},"privateKey":{...JWK}}  (Supabase edge-function secrets only)

# Secret Vercel sends with the nightly storage clean-up
CRON_SECRET=a-long-random-string

# Supabase edge functions only (set with: supabase secrets set)
# SUPABASE_SECRET_KEYS, RESEND_API_KEY, NOTIFY_WEBHOOK_SECRET

# Knowledge-base ingest scripts only (scripts/ingest)
# GOOGLE_API_KEY
